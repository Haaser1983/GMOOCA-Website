<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name"><span class="footer-mark" aria-hidden="true"></span>{{ site.legalName }}</p>
      <p>{{ site.fullName }}. A North Carolina corporation, active since {{ site.founded }}.</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
    <ul class="footer-links">
      {% for item in site.nav %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms</a></li>
      <li><a href="/ai/">How we use AI</a></li>
    </ul>
    <p class="fineprint">GMOOCA is built with help from AI tools, and we say so. <a href="/ai/">How we use AI</a>.</p>
    <p class="fineprint">{{ site.trademarks }} Nothing on this site is legal advice; gaming machine ownership rules vary by state.</p>
    <p class="fineprint">&copy; {{ site.founded }}&ndash;{{ build.year }} {{ site.legalName }}</p>
  </div>
</footer>
