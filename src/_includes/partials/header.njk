<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/" aria-label="{{ site.name }} home"><img class="wordmark-chip" src="/assets/brand/gmooca-logo-no-ring-text.svg" alt="" width="38" height="38">GMOOCA</a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {% for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
