---
layout: layouts/base.njk
---
<header class="page-head">
  {% if headLogo %}
  <div class="wrap page-head-logo">
    <h1>{{ title }}</h1>
    <img class="head-logo" src="/assets/brand/gmooca-logo.svg" alt="GMOOCA crest: a casino chip with a shield and three reels" width="160" height="160">
    {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
  </div>
  {% else %}
  <div class="wrap">
    <h1>{{ title }}</h1>
    {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
  </div>
  {% endif %}
</header>
<div class="wrap page-body{% if prose !== false %} prose{% endif %}">
  {{ content | safe }}
</div>
