---
layout: layouts/base.njk
---
<header class="page-head">
  <div class="wrap">
    <p class="crumb"><a href="/updates/">Updates</a></p>
    <h1>{{ title }}</h1>
    {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
    <p class="page-meta">Posted <time datetime="{{ page.date | dateIso }}">{{ page.date | readableDate }}</time></p>
  </div>
</header>
<div class="wrap page-body prose">
  {{ content | safe }}
</div>
