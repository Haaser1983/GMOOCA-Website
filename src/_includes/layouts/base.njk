<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " | " + site.name) if title else (site.name + " | " + site.fullName) %}
  {% set pageDesc = description or site.description %}
  {% set canonical = site.url + page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}/assets/brand/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="GMOOCA, Gaming Machine Owners, Operators and Collectors Association">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/assets/brand/icon/gmooca-icon-small.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#f1f2ee" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121714" media="(prefers-color-scheme: dark)">
  <link rel="preload" href="/assets/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css?v={{ build.version }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.legalName }}",
    "alternateName": ["{{ site.name }}", "{{ site.fullName }}"],
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/brand/gmooca-logo-512.png",
    "email": "{{ site.email }}",
    "foundingDate": "{{ site.founded }}",
    "areaServed": "US",
    "knowsAbout": ["Slot machines", "Electronic gaming machines", "SAS protocol", "G2S protocol", "Gaming machine restoration"]
  }
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
